---
import BaseLayout from "../../layouts/BaseLayout.astro";
import { PAGES } from "../../config";
import { Image } from "astro:assets";

// Import all images from the folder
const imageModules = import.meta.glob(
  "../../assets/images/blue-bungalow/*.{jpg,jpeg,webp,png}",
  {
    eager: true,
  },
);

// Convert to array and sort by filename.
const images = Object.entries(imageModules)
  .sort(([a], [b]) => {
    const aNum = parseInt(a.match(/(\d+)/)?.[0] || "0");
    const bNum = parseInt(b.match(/(\d+)/)?.[0] || "0");
    return aNum - bNum;
  })
  .map(([, module]) => module.default);

if (PAGES.blue_bungalow?.isActive === false) {
  return Astro.redirect("/404");
}
---

<div
  id="image-modal"
  class="hidden fixed inset-0 z-50 bg-black/90 flex items-center justify-center p-4"
>
  <button
    id="close-modal"
    class="absolute top-4 right-4 text-white text-5xl leading-none hover:opacity-70 transition"
  >
    &times;
  </button>

  <img
    id="modal-image"
    src=""
    alt="Expanded image"
    class="max-w-full max-h-full object-contain"
  />
</div>

<BaseLayout title={PAGES.blue_bungalow.title}>
  <div class="text-center my-16 mb-32">
    <div
      class="mx-auto container my-8 sm:columns-2 md:columns-3 lg:columns-4 xl:columns-5"
    >
      {
        images.map((image, index) => (
          <Image
            src={image}
            alt={`Blue Bungalow image ${index + 1}`}
            quality="mid"
            loading="lazy"
            data-full={image.src}
            class="gallery-image rounded-sm mb-4 border border-transparent hover:border-gray-300 transition-all duration-300 ease-in-out hover:shadow-lg w-full hover:cursor-pointer"
          />
        ))
      }
    </div>
  </div>

  <script>
    function initGalleryModal() {
      const modal = document.getElementById("image-modal");
      const modalImage = document.getElementById("modal-image");
      const closeButton = document.getElementById("close-modal");

      if (!modal || !modalImage || !closeButton) return;

      // Prevent duplicate listeners
      if (modal.dataset.initialized === "true") return;
      modal.dataset.initialized = "true";

      document.querySelectorAll(".gallery-image").forEach((img) => {
        img.addEventListener("click", () => {
          modalImage.src = img.dataset.full;

          modal.classList.remove("hidden");

          document.body.style.overflow = "hidden";
        });
      });

      function closeModal() {
        modal.classList.add("hidden");

        document.body.style.overflow = "";
      }

      closeButton.addEventListener("click", closeModal);

      modal.addEventListener("click", (e) => {
        if (e.target === modal) {
          closeModal();
        }
      });

      document.addEventListener("keydown", (e) => {
        if (e.key === "Escape") {
          closeModal();
        }
      });
    }

    // Initial page load
    initGalleryModal();

    // Astro client-side navigation
    document.addEventListener("astro:page-load", initGalleryModal);
  </script>
</BaseLayout>
